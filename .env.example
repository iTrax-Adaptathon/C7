# Copy to .env and adjust as needed. All values are optional.

# SQLAlchemy database URL. Default: the committed SQLite file in the repo root.
DATABASE_URL=sqlite:///./fitness.db

# Comma-separated list of allowed CORS origins for the frontend.
# Use "*" to allow any origin (default), or list explicit origins, e.g.
# CORS_ORIGINS=http://localhost:5173,https://my-app.lovable.app
CORS_ORIGINS=*
